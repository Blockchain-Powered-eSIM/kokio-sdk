# react-native-passkey peer-depends on react and react-native, and npm installs
# peers by default. That drags the whole React Native toolchain (metro and
# friends, ~350 packages) into a tree this SDK never imports. The app that
# consumes the SDK supplies them, so skip them here.
legacy-peer-deps=true

# Exact versions only, so an install never silently picks up a newer release.
save-exact=true
